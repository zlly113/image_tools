# ==============================================================================
# 超级工具箱 Pro (Super Toolbox Pro) - 环境变量配置模版
# 部署说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 生产环境中务必修改 ADMIN_TOKEN 和 JWT_SECRET 为强随机密钥
#    生成 32 字节高强度随机密钥命令：
#    python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# 运行环境：development（开发环境）或 production（生产环境）
# 生产环境下会强制安全告警，并默认关闭公开的 Swagger / Redoc 交互式接口文档
ENVIRONMENT=production

# 是否在生产环境中显式启用 /api/docs 和 /api/redoc 交互式文档 (默认 false)
ENABLE_API_DOCS=false

# Phase 1 管理员降级静态访问 Token (用于 API 直接调用与应急运维)
# 生产环境中若启用，必须替换为 32 字节强随机字符串；若留空或使用默认占位符，系统启动时将强制阻断
ADMIN_TOKEN=your_secure_admin_token_here_replace_me
ENABLE_STATIC_ADMIN_TOKEN=false

# Phase 2a JWT 签名密钥 (用于签发与解密用户身份 Access Token)
# 生产环境必须替换为 32 字节以上的强随机字符串，严禁使用默认值或占位符！
JWT_SECRET=your_secure_jwt_secret_key_here_replace_me

# JWT 签名算法 (默认 HS256)
JWT_ALGORITHM=HS256

# Access Token (短期) 有效期，单位：小时 (默认 2 小时)
ACCESS_TOKEN_EXPIRE_HOURS=2

# Refresh Token (长期 HttpOnly Cookie) 有效期，单位：天 (默认 30 天)
REFRESH_TOKEN_EXPIRE_DAYS=30

# 预设的初始超级管理员邮箱
FIRST_ADMIN_EMAIL=admin@example.com

# 首次超级管理员 HTTP 初始化授权令牌 (可选)
# 强烈推荐直接通过服务器本地命令行初始化: python3 create_admin.py admin@example.com <密码>
# 若留空，则系统彻底禁用 /api/v1/auth/setup-admin 远程初始化接口；若配置，则调用时必须在请求头携带 X-Setup-Token
SETUP_ADMIN_TOKEN=

# 新注册普通用户赠送的默认算力点数 (默认 50)
REGISTER_BONUS_CREDITS=50

# SQLite 数据库文件存储路径 (默认在 data/toolbox.db)
DB_PATH=data/toolbox.db

# 允许跨域请求的前端域名列表 (JSON 数组格式或英文逗号分隔)
# 生产环境请移除 localhost，仅保留您的生产域名
CORS_ORIGINS=["https://hhdzai.top", "https://www.hhdzai.top"]
